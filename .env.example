# Copy this file to .env and fill in the values. .env is ignored by git; never commit it.

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Cloudflare dashboard -> Workers AI -> Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kaggle -> Settings -> API -> Create New Token (values are inside the downloaded kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
