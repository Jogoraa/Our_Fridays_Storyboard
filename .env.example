# Copy this file to .env and fill in the values. .env is ignored by git; never commit it.
# On a clean clone you need none of these: cached outputs are reused and no model is called.

# Narration (speech). Google AI Studio -> Get API key
GEMINI_API_KEY=

# Pictures, score and video on a free GPU. Kaggle -> Settings -> API.
# The account must be phone-verified to be given a GPU.
KAGGLE_USERNAME=
# Use the new single token ...
KAGGLE_API_TOKEN=
# ... or, with an older kaggle.json, its "key" value instead.
KAGGLE_KEY=
