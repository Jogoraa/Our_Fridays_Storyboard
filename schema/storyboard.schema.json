{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/our-fridays/storyboard.schema.json",
  "title": "Our Fridays storyboard (the contract between pipeline stages)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "project_status",
    "story_note",
    "audience",
    "intent",
    "narration_language",
    "subtitle_language",
    "narration_style",
    "narration_voice",
    "visual_style",
    "style_block",
    "characters",
    "formats",
    "music",
    "shots",
    "end_card",
    "planned_duration_seconds",
    "production_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project_status": {
      "enum": [
        "draft",
        "radio_cut",
        "rough_cut",
        "final"
      ]
    },
    "story_note": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "narration_language": {
      "type": "string",
      "minLength": 2
    },
    "subtitle_language": {
      "type": "string",
      "minLength": 2
    },
    "narration_style": {
      "type": "string",
      "minLength": 1
    },
    "narration_voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "style_instruction"
      ],
      "properties": {
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "style_instruction": {
          "type": "string",
          "minLength": 1
        },
        "tempo": {
          "type": "number",
          "minimum": 0.9,
          "maximum": 1.15
        }
      }
    },
    "visual_style": {
      "type": "string",
      "minLength": 1
    },
    "style_block": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "formats": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/format"
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "caption",
        "tempo_bpm",
        "key",
        "candidates",
        "chosen",
        "mix_direction",
        "cues"
      ],
      "properties": {
        "status": {
          "enum": [
            "placeholder",
            "candidates_generated",
            "chosen"
          ]
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "tempo_bpm": {
          "type": "integer",
          "minimum": 30,
          "maximum": 200
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "seed",
              "file"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "seed": {
                "type": "integer"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ]
        },
        "mix_direction": {
          "type": "string"
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at_shot",
              "direction"
            ],
            "properties": {
              "at_shot": {
                "type": "string",
                "pattern": "^shot_[0-9]{2}$"
              },
              "direction": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "text"
      ],
      "properties": {
        "duration_seconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 5
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "planned_duration_seconds": {
      "type": "number",
      "minimum": 60,
      "maximum": 90
    },
    "production_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "wardrobe",
        "reference_asset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "wardrobe": {
          "type": "string",
          "minLength": 1
        },
        "reference_asset": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "width",
        "height"
      ],
      "properties": {
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "duration_seconds",
        "characters",
        "reason",
        "narration",
        "keyframe_prompt",
        "motion_prompt",
        "camera_move",
        "render",
        "reference_assets",
        "seed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^shot_[0-9]{2}$"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 1
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "lang",
            "source_en",
            "subtitle_en"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "lang": {
              "type": "string",
              "minLength": 2
            },
            "source_en": {
              "type": "string",
              "minLength": 1
            },
            "subtitle_en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "keyframe_prompt": {
          "type": "string",
          "minLength": 1
        },
        "motion_prompt": {
          "type": "string",
          "minLength": 1
        },
        "camera_move": {
          "enum": [
            "push_in",
            "pull_out",
            "pan_left",
            "pan_right",
            "tilt_up",
            "tilt_down",
            "static"
          ]
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "9:16",
            "16:9"
          ],
          "properties": {
            "9:16": {
              "enum": [
                "still",
                "video"
              ]
            },
            "16:9": {
              "enum": [
                "still",
                "video"
              ]
            }
          }
        },
        "overlay_text": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "at_fraction",
              "role"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "at_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "role": {
                "enum": [
                  "draft",
                  "sent",
                  "received"
                ]
              }
            }
          }
        },
        "reference_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
